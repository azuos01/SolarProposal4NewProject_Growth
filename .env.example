# Caminho do arquivo SQLite. Use ':memory:' apenas em testes.
DB_PATH=./data/app.db

# Porta HTTP do servidor.
PORT=3000

# Chave exigida no header "x-api-key" para as rotas administrativas (/api/*).
# Se deixada em branco / não definida, as rotas /api/* ficam sem autenticação
# (aceitável apenas em desenvolvimento local). O link público (/p/:token) da
# proposta NUNCA exige essa chave — é assim que o lead abre a proposta dele.
API_KEY=troque-esta-chave-em-producao
